{
  "openapi": "3.0.0",
  "info": {
    "title": "Hub Billing BFF Web API",
    "description": "API para o Backend-for-Frontend (BFF) do módulo de faturamento (billing) focado na interface web.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tarken.ag/hub/v1/",
      "description": "Servidor Tarken Hub"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BffOrganizationUserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "organizationFantasyName": {
            "type": "string"
          },
          "membershipId": {
            "type": "string"
          },
          "membershipRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipRoleDTO"
            }
          },
          "membershipRoleType": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MembershipRoleDTO": {
        "type": "object",
        "properties": {
          "roleName": {
            "type": "string"
          },
          "tagName": {
            "type": "string"
          }
        }
      },
      "BffFilterRolesTagsDTO": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BffSummaryOrganizationDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fantasyName": {
            "type": "string"
          },
          "tag": {
            "$ref": "#/components/schemas/TagSummaryDTO"
          }
        }
      },
      "TagSummaryDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "userLimits": {
            "type": "number"
          },
          "count": {
            "type": "number"
          }
        }
      },
      "BffOrganizationTagUserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "completedName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "membershipId": {
            "type": "string"
          },
          "membershipRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tagName": {
            "type": "string"
          }
        }
      },
      "BffOrganizationsContractsDTO": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContractDTO"
            }
          }
        }
      },
      "ContractDTO": {
        "type": "object",
        "properties": {
          "contractId": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "fantasyName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "monthDeadline": {
            "type": "number"
          },
          "endDate": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          }
        }
      },
      "BffContractSubscriptionDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "organizationContractId": {
            "type": "string"
          },
          "subscriptionId": {
            "type": "string"
          },
          "paymentType": {
            "type": "string"
          },
          "prePaidRestrict": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subscription": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "BffPaymentsDTO": {
        "type": "object",
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentItemDetailDTO"
            }
          },
          "pendingTotal": {
            "type": "number"
          },
          "paidTotal": {
            "type": "number"
          },
          "transferredTotal": {
            "type": "number"
          },
          "transferredDoneTotal": {
            "type": "number"
          },
          "simulatedBalance": {
            "type": "number"
          },
          "effectiveBalance": {
            "type": "number"
          },
          "organizationCount": {
            "type": "number"
          }
        }
      },
      "PaymentItemDetailDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "subscriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "costCenterId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "referenceDate": {
            "type": "string",
            "format": "date-time"
          },
          "type: {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "valueTarken": {
            "type": "number",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "documentUrlPath": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BffStatementsDTO": {
        "type": "object",
        "properties": {
          "statements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatementItemDetailDTO"
            }
          },
          "totalItems": {
            "type": "number"
          },
          "totalCost": {
            "type": "number"
          },
          "totalRecurringCost": {
            "type": "number"
          },
          "totalBalance": {
            "type": "number"
          },
          "organizationCount": {
            "type": "number"
          }
        }
      },
      "StatementItemDetailDTO": {
        "type": "object",
        "properties": {
          "referenceDate": {
            "type": "string",
            "format": "date-time"
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "applicant": {
            "type": "string"
          },
          "queryType": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "costCenter": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "registryId": {
            "type": "string"
          },
          "statementType": {
            "type": "string"
          },
          "productType": {
            "type": "string"
          },
          "balance": {
            "type": "number"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/bff/web/billing/access-control/users": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get all users from many organizations",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "List of organization IDs separated by comma"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BffOrganizationUserDTO"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/bff/web/billing/access-control/filter-roles-tags": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get all roles and tags to filters from many organizations",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffFilterRolesTagsDTO"
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/access-control/summary-organizations": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get summary information from many organizations",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BffSummaryOrganizationDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/access-control/users-organization-tag": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get all users from single organization and tag",
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tagId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BffOrganizationTagUserDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/contracts": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get all contracts from many organizations",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffOrganizationsContractsDTO"
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/contracts/{contractId}/subscriptions": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get all subscriptions from single contract.",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BffContractSubscriptionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/payment-control": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get payment control data",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscriptionIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved payment control data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffPaymentsDTO"
                }
              }
            }
          }
        }
      }
    },
    "/bff/web/billing/statements": {
      "get": {
        "tags": [
          "bff/web/billing"
        ],
        "summary": "Get statements",
        "parameters": [
          {
            "name": "organizationIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscriptionIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved statements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffStatementsDTO"
                }
              }
            }
          }
        }
      }
    }
  }
}
